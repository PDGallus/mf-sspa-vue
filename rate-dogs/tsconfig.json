{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "module": "es2022",
    "target": "es2022",
    "useDefineForClassFields": false,
    "lib": ["es2022", "dom"],
    "types": ["node"]
  }
}
